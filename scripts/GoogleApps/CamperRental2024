function getWorkflowSearchFolders_() {
  const folders = [];
  const seenFolderIds = new Set();

  function addFolder_(folder) {
    if (!folder) return;

    const folderId = folder.getId();
    if (seenFolderIds.has(folderId)) return;

    seenFolderIds.add(folderId);
    folders.push(folder);
  }

  // Keep workflow spreadsheets in the explicit top-level folder, while
  // retaining the quote-folder and parent-folder locations used historically.
  addFolder_(getWorkflowSpreadsheetFolder_());

  const rootFolder = getQuoteRootFolder_();
  addFolder_(rootFolder);
  const parents = rootFolder.getParents();

  if (parents.hasNext()) {
    const parentFolder = parents.next();
    addFolder_(parentFolder);
  }

  return folders;
}

function getFolderSearchChain_(folder) {
  const folders = [];
  const seen = {};
  let currentFolder = folder;

  while (currentFolder) {
    const folderId = currentFolder.getId();
    if (seen[folderId]) break;

    seen[folderId] = true;
    folders.push(currentFolder);

    const parents = currentFolder.getParents();
    currentFolder = parents.hasNext() ? parents.next() : null;
  }

  return folders;
}

function findGoogleSheetByNamesInFolder_(folder, possibleNames) {
  for (const fileName of possibleNames) {
    const matchingFiles = folder.getFilesByName(fileName);
    let matchedFile = null;
    let matchCount = 0;

    while (matchingFiles.hasNext()) {
      const file = matchingFiles.next();
      if (file.getMimeType() !== MimeType.GOOGLE_SHEETS) continue;

      if (!matchedFile) matchedFile = file;
      matchCount++;
    }

    if (!matchedFile) continue;

    if (matchCount > 1) {
      Logger.log(`WARNING - Multiple Google Sheets named '${fileName}' found in '${folder.getName()}'. Using the first match.`);
    }

    return {
      file: matchedFile,
      matchedName: fileName,
      folder: folder
    };
  }

  return null;
}

function isWorkflowSpreadsheetName_(fileName) {
  return /^HHRentals-?\d{4}-?IncomeExpenses$/.test(String(fileName || "").trim());
}

function getAllWorkflowSpreadsheets_() {
  const spreadsheets = [];
  const seenFileIds = {};
  const folders = getWorkflowSearchFolders_();

  for (const folder of folders) {
    const files = folder.getFiles();

    while (files.hasNext()) {
      const file = files.next();
      const fileId = file.getId();

      if (seenFileIds[fileId]) continue;
      if (file.getMimeType() !== MimeType.GOOGLE_SHEETS) continue;
      if (!isWorkflowSpreadsheetName_(file.getName())) continue;

      seenFileIds[fileId] = true;
      spreadsheets.push(SpreadsheetApp.openById(fileId));
    }
  }

  return spreadsheets;
}

function getRentalAgreementSearchFolders_(startDateValue) {
  const folders = [];
  const seenFolderIds = {};

  function addFolder_(folder) {
    if (!folder) return;

    const folderId = folder.getId();
    if (seenFolderIds[folderId]) return;

    seenFolderIds[folderId] = true;
    folders.push(folder);
  }

  try {
    addFolder_(getQuoteStorageFolderForDate_(startDateValue).yearFolder);
  } catch (e) {
    Logger.log(`Could not derive year folder from start date '${startDateValue}': ${e}`);
  }

  const configuredFolder = getConfiguredQuoteFolder_();
  const rootFolder = getQuoteRootFolder_();

  addFolder_(configuredFolder);
  addFolder_(rootFolder);

  const rootSubfolders = rootFolder.getFolders();
  while (rootSubfolders.hasNext()) {
    const folder = rootSubfolders.next();
    if (!/^\d{4}$/.test(String(folder.getName() || "").trim())) continue;
    addFolder_(folder);
  }

  return folders;
}

function getQuoteStorageFolderForDate_(dateValue) {
  const bookingDate = parseSheetDate_(dateValue);
  if (!bookingDate) {
    throw new Error(`Cannot determine quote storage folder because the booking start date '${dateValue}' is invalid.`);
  }

  const bookingYear = bookingDate.getFullYear();
  const rootFolder = getQuoteRootFolder_();
  const folderName = getYearFolderName_(bookingYear);
  let matchingFolders = rootFolder.getFoldersByName(folderName);

  if (!matchingFolders.hasNext()) {
    const lock = LockService.getScriptLock();
    lock.waitLock(30000);

    try {
      // Recheck after acquiring the lock so concurrent quote requests do not
      // create duplicate year folders.
      matchingFolders = rootFolder.getFoldersByName(folderName);
      if (!matchingFolders.hasNext()) {
        rootFolder.createFolder(folderName);
        Logger.log(`Created quote storage folder '${folderName}' under '${rootFolder.getName()}'.`);
        matchingFolders = rootFolder.getFoldersByName(folderName);
      }
    } finally {
      lock.releaseLock();
    }
  }

  const yearFolder = matchingFolders.next();
  if (matchingFolders.hasNext()) {
    Logger.log(`WARNING - Multiple year folders named '${folderName}' found in '${rootFolder.getName()}'. Using the first match.`);
  }

  return {
    year: bookingYear,
    rootFolder: rootFolder,
    yearFolder: yearFolder
  };
}

function getWorkflowSpreadsheetForYear_(year) {
  const normalizedYear = String(year || "").trim();
  if (!/^\d{4}$/.test(normalizedYear)) {
    throw new Error(`Cannot provision workflow spreadsheet for invalid year '${year}'.`);
  }

  const rootFolder = getWorkflowSpreadsheetFolder_();
  const possibleNames = getIncomeExpensesSpreadsheetNamesForYear_(normalizedYear);
  const folderSearchChain = getWorkflowSearchFolders_();

  function findExistingSpreadsheet_() {
    for (const folder of folderSearchChain) {
      const match = findGoogleSheetByNamesInFolder_(folder, possibleNames);
      if (match) {
        Logger.log(
          `Using workflow spreadsheet '${match.matchedName}' from folder '${match.folder.getName()}' for ${normalizedYear}.`
        );
        return SpreadsheetApp.openById(match.file.getId());
      }
    }

    return null;
  }

  const existingSpreadsheet = findExistingSpreadsheet_();
  if (existingSpreadsheet) return existingSpreadsheet;

  const lock = LockService.getScriptLock();
  lock.waitLock(30000);

  try {
    // Recheck after acquiring the lock so concurrent quote requests do not
    // create duplicate yearly workbooks.
    const lockedExistingSpreadsheet = findExistingSpreadsheet_();
    if (lockedExistingSpreadsheet) return lockedExistingSpreadsheet;

    const templateConfig = getGoogleAsset_("workflowSpreadsheetTemplate");
    const templateFile = getDriveFileByIdOrName_(templateConfig.id, templateConfig.name);
    if (!templateFile) {
      throw new Error(
        `Missing workflow spreadsheet template '${templateConfig.name}' for ${normalizedYear}.`
      );
    }

    const targetName = `HHRentals-${normalizedYear}IncomeExpenses`;
    const targetFile = templateFile.makeCopy(targetName, rootFolder);
    const newSpreadsheet = SpreadsheetApp.openById(targetFile.getId());

    syncMetadataToSheet_(newSpreadsheet, getMetadata_(true));
    initializeNextBookingId_(newSpreadsheet, normalizedYear);
    validateWorkflowSpreadsheetStructure_(newSpreadsheet);
    ensureSpreadsheetTriggers_(newSpreadsheet);

    Logger.log(
      `Created workflow spreadsheet '${targetName}' from '${templateFile.getName()}' in '${rootFolder.getName()}'.`
    );
    return newSpreadsheet;
  } finally {
    lock.releaseLock();
  }
}

function initializeNextBookingId_(spreadsheet, year) {
  const nextBookingRange = spreadsheet.getRangeByName("nextBookingId");
  if (!nextBookingRange) {
    throw new Error(`Named range 'nextBookingId' is missing from '${spreadsheet.getName()}'.`);
  }

  // Existing booking IDs use the four-digit year followed by a two-digit
  // sequence. Start each newly provisioned year at sequence 01.
  nextBookingRange.setValue(Number(year) * 100 + 1);
}

function validateWorkflowSpreadsheetStructure_(spreadsheet) {
  const requiredSheetNames = [
    SUMMARY_SHEET_NAME,
    BOOKINGS_SHEET_NAME,
    WAITING_SHEET_NAME,
    QUOTE_SHEET_NAME,
    INCOME_SHEET_NAME,
    EXPENSES_SHEET_NAME,
    MILEAGE_SHEET_NAME,
    NH_MR_TAX_SHEET_NAME,
    CONTRACT_DATA_SHEET_NAME,
    INVOICE_DATA_SHEET_NAME,
    METADATA_SHEET_NAME
  ];

  requiredSheetNames.forEach(sheetName => {
    if (!spreadsheet.getSheetByName(sheetName)) {
      throw new Error(`Provisioned workflow spreadsheet is missing required sheet '${sheetName}'.`);
    }
  });

  const requiredPlaceholders = [
    [BOOKINGS_SHEET_NAME, "{{nextRenter}}"],
    [WAITING_SHEET_NAME, "{{nextQuote}}"],
    [INCOME_SHEET_NAME, ENTRY_INSERT_PLACEHOLDER],
    [EXPENSES_SHEET_NAME, ENTRY_INSERT_PLACEHOLDER],
    [MILEAGE_SHEET_NAME, ENTRY_INSERT_PLACEHOLDER]
  ];

  requiredPlaceholders.forEach(item => {
    const sheet = spreadsheet.getSheetByName(item[0]);
    if (!findExactCell_(sheet, item[1])) {
      throw new Error(`Provisioned '${item[0]}' sheet is missing required placeholder '${item[1]}'.`);
    }
  });
}

function getQuoteWorkflowContext_(startDateValue) {
  const bookingDate = parseSheetDate_(startDateValue);
  if (!bookingDate) {
    throw new Error(`Cannot determine workflow year because the booking start date '${startDateValue}' is invalid.`);
  }

  const folderContext = getQuoteStorageFolderForDate_(bookingDate);
  const workflowSpreadsheet = getWorkflowSpreadsheetForYear_(folderContext.year);

  return {
    bookingDate: bookingDate,
    year: folderContext.year,
    rootFolder: folderContext.rootFolder,
    yearFolder: folderContext.yearFolder,
    spreadsheet: workflowSpreadsheet
  };
}

function findExactCell_(sheet, text) {
  return sheet.createTextFinder(text).matchEntireCell(true).findNext();
}

/**
 * Named range / document template merge helpers for TemplateRentalAgreement-2026.
 */
function getNamedRangeMergeValues_(ss) {
  const values = {};

  ss.getNamedRanges().forEach(namedRange => {
    const name = namedRange.getName();
    const range = namedRange.getRange();
    values[name] = range.getDisplayValue();
  });

  return values;
}

function escapeForReplaceText_(text) {
  return String(text).replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

function replaceNamedRangePlaceholders_(doc, mergeValues) {
  const body = doc.getBody();
  const header = doc.getHeader();
  const footer = doc.getFooter();

  Object.keys(mergeValues).forEach(name => {
    const placeholder = `<<${name}>>`;
    const escapedPlaceholder = escapeForReplaceText_(placeholder);
    const value = String(mergeValues[name] || "");

    body.replaceText(escapedPlaceholder, value);
    if (header) header.replaceText(escapedPlaceholder, value);
    if (footer) footer.replaceText(escapedPlaceholder, value);
  });
}

function getMergeValue_(mergeValues, possibleNames) {
  for (const name of possibleNames) {
    if (mergeValues[name] !== undefined && String(mergeValues[name]).trim() !== "") {
      return String(mergeValues[name]).trim();
    }
  }
  return "";
}

function parseSheetDate_(value) {
  if (Object.prototype.toString.call(value) === "[object Date]" && !isNaN(value)) {
    return value;
  }

  const parsed = new Date(value);
  return isNaN(parsed.getTime()) ? null : parsed;
}

function addDays_(dateValue, daysToAdd) {
  const parsedDate = parseSheetDate_(dateValue);
  if (!parsedDate) return null;

  const result = new Date(parsedDate.getTime());
  result.setDate(result.getDate() + Number(daysToAdd || 0));
  return result;
}

function formatSheetDate_(dateValue) {
  const parsedDate = parseSheetDate_(dateValue);
  if (!parsedDate) return "";
  return Utilities.formatDate(parsedDate, Session.getScriptTimeZone(), "MM/dd/yyyy");
}

function normalizeSheetDate_(dateValue) {
  const parsedDate = parseSheetDate_(dateValue);
  if (!parsedDate) return null;
  return new Date(parsedDate.getFullYear(), parsedDate.getMonth(), parsedDate.getDate());
}

function getDateKey_(dateValue) {
  const normalizedDate = normalizeSheetDate_(dateValue);
  if (!normalizedDate) return "";
  return Utilities.formatDate(normalizedDate, Session.getScriptTimeZone(), "yyyy-MM-dd");
}

function getDateRangeDayKeys_(startDateValue, endDateValue) {
  const startDate = normalizeSheetDate_(startDateValue);
  const endDate = normalizeSheetDate_(endDateValue);
  if (!startDate || !endDate || endDate < startDate) return [];

  const dayKeys = [];
  for (let d = new Date(startDate.getTime()); d <= endDate; d.setDate(d.getDate() + 1)) {
    dayKeys.push(getDateKey_(d));
  }

  return dayKeys;
}

function doDateRangesOverlap_(firstStartDate, firstEndDate, secondStartDate, secondEndDate) {
  const firstRangeDayKeys = getDateRangeDayKeys_(firstStartDate, firstEndDate);
  const secondRangeDayKeys = getDateRangeDayKeys_(secondStartDate, secondEndDate);
  if (!firstRangeDayKeys.length || !secondRangeDayKeys.length) return false;

  const secondRangeLookup = {};
  secondRangeDayKeys.forEach(dayKey => {
    secondRangeLookup[dayKey] = true;
  });

  return firstRangeDayKeys.some(dayKey => secondRangeLookup[dayKey]);
}

function isSameSheetDate_(firstDateValue, secondDateValue) {
  const firstDateKey = getDateKey_(firstDateValue);
  const secondDateKey = getDateKey_(secondDateValue);
  return firstDateKey !== "" && firstDateKey === secondDateKey;
}

function isBackToBackBooking_(quoteStartDate, quoteEndDate, existingStartDate, existingEndDate) {
  return isSameSheetDate_(quoteStartDate, existingEndDate) || isSameSheetDate_(quoteEndDate, existingStartDate);
}

function normalizeTextValue_(value) {
  return String(value || "").trim().toLowerCase();
}

function buildQuoteConflictMessage_(severity, conflictType, sheetName, rowNumber, rowData, bookingKind) {
  const camper = String(rowData["Camper"] || "").trim();
  const renterName = String(rowData["Renter Name"] || "").trim() || "unknown renter";
  const startDate = formatSheetDate_(rowData["Start Date"]) || String(rowData["Start Date"] || "").trim();
  const endDate = formatSheetDate_(rowData["End Date"]) || String(rowData["End Date"] || "").trim();

  return `${severity}: ${conflictType} with ${bookingKind} in '${sheetName}' row ${rowNumber} for camper '${camper}' (${startDate} - ${endDate}, ${renterName}).`;
}

function getSheetRowsByHeaders_(sheet, headerRow) {
  const lastRow = sheet.getLastRow();
  const lastCol = sheet.getLastColumn();
  if (lastRow <= headerRow || lastCol < 1) return [];

  const headers = sheet.getRange(headerRow, 1, 1, lastCol).getDisplayValues()[0];
  const values = sheet.getRange(headerRow + 1, 1, lastRow - headerRow, lastCol).getDisplayValues();

  return values.map((rowValues, index) => {
    const data = {};
    headers.forEach((header, headerIndex) => {
      if (header) data[String(header).trim()] = rowValues[headerIndex];
    });

    return {
      rowNumber: headerRow + 1 + index,
      data: data
    };
  });
}

function validateBookingConflictHeaders_(sheet, headerRow) {
  const requiredHeaders = ["Camper", "Start Date", "End Date"];
  const missingHeaders = requiredHeaders.filter(headerName => !getColumnByHeader_(sheet, headerRow, headerName));
  if (!missingHeaders.length) return;

  throw new Error(`Sheet '${sheet.getName()}' is missing required header(s): ${missingHeaders.join(", ")}.`);
}

function getQuoteConflicts_(workflowSpreadsheet, quoteContext) {
  const bookingsSheet = workflowSpreadsheet.getSheetByName(BOOKINGS_SHEET_NAME);
  const waitingSheet = workflowSpreadsheet.getSheetByName(WAITING_SHEET_NAME);

  if (!bookingsSheet) {
    throw new Error(`Sheet '${BOOKINGS_SHEET_NAME}' not found in '${workflowSpreadsheet.getName()}'.`);
  }
  if (!waitingSheet) {
    throw new Error(`Sheet '${WAITING_SHEET_NAME}' not found in '${workflowSpreadsheet.getName()}'.`);
  }

  validateBookingConflictHeaders_(bookingsSheet, BOOKINGS_HEADER_ROW);
  validateBookingConflictHeaders_(waitingSheet, WAITING_HEADER_ROW);

  const conflicts = {
    errors: [],
    warnings: []
  };

  function scanSheet_(sheet, headerRow, bookingKind, bookingConflictSeverity) {
    const rows = getSheetRowsByHeaders_(sheet, headerRow);

    rows.forEach(row => {
      const rowData = row.data;
      const camper = String(rowData["Camper"] || "").trim();
      const startDate = parseSheetDate_(rowData["Start Date"]);
      const endDate = parseSheetDate_(rowData["End Date"]);

      if (!camper || !startDate || !endDate) return;

      const sameCamper = normalizeTextValue_(camper) === normalizeTextValue_(quoteContext.camper);
      const isBackToBack = sameCamper && isBackToBackBooking_(quoteContext.startDate, quoteContext.endDate, startDate, endDate);

      if (isBackToBack) {
        conflicts.warnings.push(
          buildQuoteConflictMessage_(
            "warning",
            "back-to-back booking",
            sheet.getName(),
            row.rowNumber,
            rowData,
            bookingKind
          )
        );
      } else if (sameCamper && doDateRangesOverlap_(quoteContext.startDate, quoteContext.endDate, startDate, endDate)) {
        const bookingConflictMessage = buildQuoteConflictMessage_(
          bookingConflictSeverity,
          "booking conflict",
          sheet.getName(),
          row.rowNumber,
          rowData,
          bookingKind
        );

        if (bookingConflictSeverity === "error") {
          conflicts.errors.push(bookingConflictMessage);
        } else {
          conflicts.warnings.push(bookingConflictMessage);
        }
      }

      const hasDeliveryConflict =
        isSameSheetDate_(startDate, quoteContext.startDate) ||
        isSameSheetDate_(startDate, quoteContext.endDate) ||
        isSameSheetDate_(endDate, quoteContext.startDate) ||
        isSameSheetDate_(endDate, quoteContext.endDate);

      if (hasDeliveryConflict) {
        conflicts.warnings.push(
          buildQuoteConflictMessage_(
            "warning",
            "delivery conflict",
            sheet.getName(),
            row.rowNumber,
            rowData,
            bookingKind
          )
        );
      }
    });
  }

  scanSheet_(bookingsSheet, BOOKINGS_HEADER_ROW, "confirmed booking", "error");
  scanSheet_(waitingSheet, WAITING_HEADER_ROW, "potential booking", "warning");

  return conflicts;
}

