function getBlockingMetadataProtectionIssues_(writeRanges) {
  const issues = [];
  const seen = new Set();

  function rangesOverlap_(firstRange, secondRange) {
    if (firstRange.getSheet().getSheetId() !== secondRange.getSheet().getSheetId()) return false;

    const firstBottom = firstRange.getRow() + firstRange.getNumRows() - 1;
    const firstRight = firstRange.getColumn() + firstRange.getNumColumns() - 1;
    const secondBottom = secondRange.getRow() + secondRange.getNumRows() - 1;
    const secondRight = secondRange.getColumn() + secondRange.getNumColumns() - 1;

    return firstRange.getRow() <= secondBottom && secondRange.getRow() <= firstBottom &&
      firstRange.getColumn() <= secondRight && secondRange.getColumn() <= firstRight;
  }

  writeRanges.forEach(target => {
    const protections = target.range.getSheet()
      .getProtections(SpreadsheetApp.ProtectionType.SHEET)
      .concat(target.range.getSheet().getProtections(SpreadsheetApp.ProtectionType.RANGE));

    protections.forEach(protection => {
      if (protection.isWarningOnly() || protection.canEdit()) return;

      let protectedRange;
      try {
        protectedRange = protection.getRange();
      } catch (e) {
        const key = `${target.range.getSheet().getSheetId()}:unknown`;
        if (!seen.has(key)) {
          seen.add(key);
          issues.push(`a protection on '${target.range.getSheet().getName()}' could not be inspected`);
        }
        return;
      }

      if (!rangesOverlap_(target.range, protectedRange)) return;

      const key = `${protectedRange.getSheet().getSheetId()}:${protectedRange.getA1Notation()}`;
      if (seen.has(key)) return;

      seen.add(key);
      issues.push(
        `protected range '${protectedRange.getSheet().getName()}!${protectedRange.getA1Notation()}' overlaps ${target.label}`
      );
    });
  });

  return issues;
}

function getMetadataSyncCompatibilityIssues_(spreadsheet, metadata) {
  const issues = [];
  const layout = buildMetadataSheetData_(metadata);
  const requiredSheets = [
    QUOTE_SHEET_NAME,
    SUMMARY_SHEET_NAME,
    BOOKINGS_SHEET_NAME,
    CONTRACT_DATA_SHEET_NAME,
    MILEAGE_SHEET_NAME
  ];

  requiredSheets.forEach(sheetName => {
    if (!spreadsheet.getSheetByName(sheetName)) {
      issues.push(`missing required sheet '${sheetName}'`);
    }
  });

  const quoteSheet = spreadsheet.getSheetByName(QUOTE_SHEET_NAME);
  if (quoteSheet) {
    [
      ["A20", "Add-Ons"],
      ["A22", "Fees"],
      ["A23", "8.5% NH M&R Tax"],
      ["A24", "Expected Income"],
      ["A25", "Deposit req:"],
      ["A26", "Next Payment"],
      ["A27", "Final payment:"],
      ["A28", "Full refund date:"]
    ].forEach(item => {
      const actualLabel = String(quoteSheet.getRange(item[0]).getDisplayValue() || "").trim();
      if (actualLabel !== item[1]) {
        issues.push(`Quote layout mismatch at ${item[0]}: expected '${item[1]}', found '${actualLabel}'`);
      }
    });
  }

  const summarySheet = spreadsheet.getSheetByName(SUMMARY_SHEET_NAME);
  if (summarySheet) {
    if (String(summarySheet.getRange("B21").getDisplayValue() || "").trim() !== "Total") {
      issues.push("Summary layout mismatch: expected 'Total' in B21");
    } else {
      const outputRow = 21;
      const firstOutputColumn = 3;
      const camperCount = metadata.campers.length;
      const columnsToInspect = Math.max(
        camperCount,
        summarySheet.getLastColumn() - firstOutputColumn + 1
      );
      const existingRange = summarySheet.getRange(outputRow, firstOutputColumn, 1, columnsToInspect);
      const existingFormulas = existingRange.getFormulas()[0];
      const existingValues = existingRange.getValues()[0];

      for (let index = 0; index < camperCount; index++) {
        const hasContent = existingFormulas[index] || existingValues[index] !== "";
        if (hasContent && !isSummaryCamperFormula_(existingFormulas[index])) {
          const cell = existingRange.getCell(1, index + 1).getA1Notation();
          issues.push(`Summary contains unmanaged content in ${cell}`);
        }
      }
    }
  }

  [
    "metadataCamperList",
    "metadataRateTierList",
    "metadataHolidayList",
    "metadataAddOnList",
    "metadataFeeList"
  ].forEach(name => {
    if (!layout.namedRanges[name]) issues.push(`metadata layout is missing named range '${name}'`);
  });

  getBlockingMetadataProtectionIssues_(getMetadataSyncWriteRanges_(spreadsheet, metadata, layout))
    .forEach(issue => issues.push(issue));

  return issues;
}

function assertMetadataSyncCompatibility_(spreadsheet, metadata) {
  const issues = getMetadataSyncCompatibilityIssues_(spreadsheet, metadata);
  if (issues.length) {
    throw new Error(`Metadata sync is not safe for '${spreadsheet.getName()}': ${issues.join("; ")}.`);
  }
}

function syncMetadataToSheet_(spreadsheet, metadata) {
  const targetSpreadsheet = spreadsheet || SpreadsheetApp.getActiveSpreadsheet();
  const sourceMetadata = metadata || getMetadata_(true);
  assertMetadataSyncCompatibility_(targetSpreadsheet, sourceMetadata);
  const layout = buildMetadataSheetData_(sourceMetadata);
  let sheet = targetSpreadsheet.getSheetByName(METADATA_SHEET_NAME);
  if (!sheet) sheet = targetSpreadsheet.insertSheet(METADATA_SHEET_NAME);

  const clearRows = Math.max(sheet.getLastRow(), layout.rows.length, 1);
  const clearColumns = Math.max(sheet.getLastColumn(), 10);
  if (sheet.getMaxRows() < clearRows) {
    sheet.insertRowsAfter(sheet.getMaxRows(), clearRows - sheet.getMaxRows());
  }
  if (sheet.getMaxColumns() < clearColumns) {
    sheet.insertColumnsAfter(sheet.getMaxColumns(), clearColumns - sheet.getMaxColumns());
  }
  sheet.getRange(1, 1, clearRows, clearColumns).clear();
  sheet.getRange(1, 1, layout.rows.length, 10).setValues(layout.rows);
  sheet.setFrozenRows(1);
  sheet.getRange(1, 1, 1, 10).setFontWeight("bold").setBackground("#eeeeee");
  layout.sectionRows.forEach(row => {
    sheet.getRange(row, 1, 1, 10).setFontWeight("bold").setBackground("#eeeeee");
    sheet.getRange(row + 1, 1, 1, 10).setFontWeight("bold");
  });
  layout.percentRanges.forEach(range => sheet.getRange(range).setNumberFormat("0.00%"));
  layout.currencyRanges.forEach(range => sheet.getRange(range).setNumberFormat("$#,##0.00"));
  sheet.setColumnWidth(1, 220);
  sheet.setColumnWidth(2, 180);
  sheet.setColumnWidth(3, 190);
  sheet.setColumnWidth(4, 300);
  for (let column = 5; column <= 10; column++) sheet.setColumnWidth(column, 120);

  Object.keys(layout.namedRanges).forEach(name => {
    const definition = layout.namedRanges[name];
    const range = sheet.getRange(definition.row, definition.column, definition.numRows, definition.numColumns);
    replaceNamedRange_(targetSpreadsheet, name, range);
  });
  removeNamedRanges_(targetSpreadsheet, ["driverData", "RT_MPG_Aaron", "FeeList", "addOnList"]);

  migrateQuoteToMetadata_(targetSpreadsheet);
  migrateSummaryToMetadata_(targetSpreadsheet, sourceMetadata);
  migrateBookingsToMetadata_(targetSpreadsheet);
  migrateContractDataToMetadata_(targetSpreadsheet);
  migrateMileageToMetadata_(targetSpreadsheet);
  SpreadsheetApp.flush();
  return sheet;
}

function syncMetadataToSheet() {
  const metadata = getMetadata_(true);
  const targets = getMetadataSyncTargets_(metadata);
  const status = [];
  let syncedCount = 0;

  targets.forEach(target => {
    const issues = getMetadataSyncCompatibilityIssues_(target.spreadsheet, metadata);
    if (issues.length) {
      const message = `Skipped '${target.label}': ${issues.join("; ")}.`;
      status.push(`⚠️ ${message}`);
      Logger.log(`WARNING - ${message}`);
      return;
    }

    try {
      const sheet = syncMetadataToSheet_(target.spreadsheet, metadata);
      syncedCount++;
      const message = `Synced '${target.label}' (${sheet.getLastRow()} metadata rows).`;
      status.push(`✅ ${message}`);
      Logger.log(`SUCCESS - ${message}`);
    } catch (e) {
      const message = `Failed '${target.label}': ${e}`;
      status.push(`⚠️ ${message}`);
      Logger.log(`WARNING - ${message}`);
    }
  });

  if (!targets.length) {
    status.push("⚠️ No template or current/future canonical workflow spreadsheets were found.");
  }

  SpreadsheetApp.getActiveSpreadsheet().toast(
    `${status.join("\n")}\n\nSynced ${syncedCount} of ${targets.length} target workbook(s).`,
    "Metadata Sync",
    8
  );
}

/**
 * Helper functions for distance and duration calculations
 */
const ROUTE_CACHE_TTL_SECONDS = 21600;
const ROUTE_CACHE_VERSION_PROPERTY = "HHR_ROUTE_CACHE_VERSION";

function MilesFromHome(address) {
  const routeSummary = getRouteSummaryFromHome_(address);
  return routeSummary.miles;
}

function HoursFromHome(address) {
  const routeSummary = getRouteSummaryFromHome_(address);
  return routeSummary.hours;
}

function metersToMiles(meters) {
  if (typeof meters !== 'number') return null;
  return meters / 1000 * 0.621371;
}

function getRouteSummaryFromHome_(address) {
  const destination = String(address || "").trim();
  if (!destination) return { miles: "unknown", hours: "unknown" };

  const origin = String(getMetadata_().business.homeAddress || "").trim();
  if (!origin) throw new Error("Metadata business.homeAddress is required for route calculations.");

  const cache = CacheService.getScriptCache();
  const cacheKey = getRouteCacheKey_(origin, destination);
  const cachedSummary = cache.get(cacheKey);
  if (cachedSummary) {
    try {
      return JSON.parse(cachedSummary);
    } catch (e) {
      Logger.log(`Could not parse cached route summary for '${destination}': ${e}`);
    }
  }

  const directions = Maps.newDirectionFinder()
    .setOrigin(origin)
    .setDestination(destination)
    .setMode(Maps.DirectionFinder.Mode.DRIVING)
    .getDirections();

  if (directions && directions.error_message) throw new Error(directions.error_message);
  if (directions && directions.status && directions.status !== "OK") {
    throw new Error(`Directions lookup failed for '${destination}' with status '${directions.status}'.`);
  }

  const leg = directions &&
    directions.routes &&
    directions.routes[0] &&
    directions.routes[0].legs &&
    directions.routes[0].legs[0];

  if (!leg) {
    return { miles: "unknown", hours: "unknown" };
  }

  const routeSummary = {
    miles: leg.distance && typeof leg.distance.value === "number"
      ? metersToMiles(leg.distance.value)
      : "unknown",
    hours: leg.duration && leg.duration.text
      ? leg.duration.text
      : "unknown"
  };

  try {
    cache.put(cacheKey, JSON.stringify(routeSummary), ROUTE_CACHE_TTL_SECONDS);
  } catch (e) {
    Logger.log(`Could not cache route summary for '${destination}': ${e}`);
  }

  return routeSummary;
}

function getRouteCacheVersion_() {
  const storedVersion = PropertiesService.getScriptProperties().getProperty(ROUTE_CACHE_VERSION_PROPERTY);
  const parsedVersion = Number.parseInt(storedVersion, 10);
  return Number.isSafeInteger(parsedVersion) && parsedVersion > 0 ? parsedVersion : 1;
}

function getRouteCacheKey_(origin, destination) {
  const normalizedRoute = [origin, destination]
    .map(value => String(value || "").trim().toLowerCase())
    .join("\n");
  const digest = Utilities.computeDigest(
    Utilities.DigestAlgorithm.SHA_256,
    normalizedRoute,
    Utilities.Charset.UTF_8
  ).map(byte => (`0${((byte + 256) % 256).toString(16)}`).slice(-2)).join("");

  return `route:v${getRouteCacheVersion_()}:${digest}`;
}

/**
 * Clears cached metadata and invalidates all route cache entries.
 * Run manually after publishing metadata or changing the business home address.
 */
function clearMetadataAndRouteCaches() {
  const cache = CacheService.getScriptCache();
  cache.remove(METADATA_CACHE_KEY);

  const scriptProperties = PropertiesService.getScriptProperties();
  const currentVersion = getRouteCacheVersion_();
  const nextVersion = currentVersion >= Number.MAX_SAFE_INTEGER ? 1 : currentVersion + 1;
  scriptProperties.setProperty(ROUTE_CACHE_VERSION_PROPERTY, String(nextVersion));

  const spreadsheet = SpreadsheetApp.getActiveSpreadsheet();
  if (spreadsheet) {
    spreadsheet.toast("Metadata and route caches cleared.", "Cache Cleared", 5);
  }

  return nextVersion;
}


/**
 * Status log helpers used by quote, booking, and invoice workflows.
 */
function addStatus_(statusLog, step, success, detail) {
  const message = `${success ? "✅" : "⚠️"} ${step}: ${detail}`;
  statusLog.push(message);
  Logger.log(`${success ? "SUCCESS" : "WARNING"} - ${step}: ${detail}`);
}

function showStatusLog_(title, statusLog) {
  const message = statusLog && statusLog.length ? statusLog.join("\n") : "No status messages were recorded.";
  try {
    SpreadsheetApp.getUi().alert(title, message, SpreadsheetApp.getUi().ButtonSet.OK);
  } catch (e) {
    try {
      SpreadsheetApp.getActiveSpreadsheet().toast(message, title, 10);
    } catch (toastErr) {
      Logger.log(`Could not display toast for ${title}: ${toastErr}`);
    }
    Logger.log(`${title}: ${message}`);
  }
}

function showMessage_(title, message, options) {
  const settings = options || {};
  const preferToastOnly = settings.preferToastOnly === true;
  const toastSeconds = settings.toastSeconds || 8;

  if (!preferToastOnly) {
    try {
      SpreadsheetApp.getUi().alert(title, message, SpreadsheetApp.getUi().ButtonSet.OK);
      return;
    } catch (e) {
      Logger.log(`Could not display alert for ${title}: ${e}`);
    }
  }

  try {
    SpreadsheetApp.getActiveSpreadsheet().toast(message, title, toastSeconds);
  } catch (toastErr) {
    Logger.log(`Could not display toast for ${title}: ${toastErr}`);
  }

  Logger.log(`${title}: ${message}`);
}


