/**
 * Static business metadata.
 *
 * HHR_METADATA_URL may be set in Script Properties for preview deployments.
 * Only the production site and its GitHub Pages host are accepted.
 */
const METADATA_DEFAULT_URL = "https://happyhookerrentals.com/data/metadata.json";
const METADATA_CACHE_KEY = "hhr:metadata:v1";
const METADATA_CACHE_TTL_SECONDS = 21600;
const METADATA_SHEET_NAME = "metadata";
const METADATA_ALLOWED_HOSTS = ["happyhookerrentals.com", "shanehooker.github.io"];

function getMetadataUrl_() {
  const configuredUrl = PropertiesService.getScriptProperties().getProperty("HHR_METADATA_URL");
  const metadataUrl = String(configuredUrl || METADATA_DEFAULT_URL).trim();
  const match = metadataUrl.match(/^https:\/\/([^/?#]+)\/data\/metadata\.json(?:[?#].*)?$/i);

  if (!match || METADATA_ALLOWED_HOSTS.indexOf(match[1].toLowerCase()) === -1) {
    throw new Error("HHR_METADATA_URL must use HTTPS and point to /data/metadata.json on an approved host.");
  }

  return metadataUrl;
}

function fetchMetadata_() {
  const metadataUrl = getMetadataUrl_();
  const response = UrlFetchApp.fetch(metadataUrl, {
    method: "get",
    headers: { Accept: "application/json" },
    followRedirects: false,
    muteHttpExceptions: true
  });
  const status = response.getResponseCode();

  if (status !== 200) {
    throw new Error(`Metadata fetch failed with HTTP ${status} from ${metadataUrl}.`);
  }

  const body = response.getContentText();
  if (body.length > 500000) throw new Error("Metadata response exceeds the 500 KB safety limit.");

  let metadata;
  try {
    metadata = JSON.parse(body);
  } catch (e) {
    throw new Error(`Metadata response is not valid JSON: ${e.message}`);
  }

  return validateMetadata_(metadata);
}

function getMetadata_(forceRefresh) {
  const cache = CacheService.getScriptCache();

  if (forceRefresh !== true) {
    const cached = cache.get(METADATA_CACHE_KEY);
    if (cached) {
      try {
        return validateMetadata_(JSON.parse(cached));
      } catch (e) {
        Logger.log(`Ignoring invalid cached metadata: ${e.message}`);
      }
    }
  }

  const metadata = fetchMetadata_();
  try {
    cache.put(METADATA_CACHE_KEY, JSON.stringify(metadata), METADATA_CACHE_TTL_SECONDS);
  } catch (e) {
    Logger.log(`Could not cache metadata: ${e.message}`);
  }
  return metadata;
}

function validateMetadata_(metadata) {
  if (!metadata || Object.prototype.toString.call(metadata) !== "[object Object]") {
    throw new Error("Metadata root must be an object.");
  }

  const requiredObjects = ["business", "googleAssets", "delivery", "pricingRules"];
  requiredObjects.forEach(key => {
    if (!metadata[key] || Object.prototype.toString.call(metadata[key]) !== "[object Object]") {
      throw new Error(`Metadata section '${key}' is required and must be an object.`);
    }
  });

  const requiredArrays = ["rateTiers", "holidays", "campers", "fees", "addOns"];
  requiredArrays.forEach(key => {
    if (!Array.isArray(metadata[key])) {
      throw new Error(`Metadata section '${key}' is required and must be an array.`);
    }
  });

  ["name", "homeAddress", "contactEmail", "contactPhone"].forEach(key => {
    if (!String(metadata.business[key] || "").trim()) {
      throw new Error(`Metadata business.${key} is required.`);
    }
  });

  ["topLevelFolder", "quoteFolder", "workflowSpreadsheetTemplate"].forEach(key => {
    const asset = metadata.googleAssets[key];
    if (!asset || !String(asset.id || "").trim() || !String(asset.name || "").trim()) {
      throw new Error(`Metadata googleAssets.${key} requires a name and id.`);
    }
  });

  const camperIds = {};
  const camperNames = {};
  metadata.campers.forEach((camper, index) => {
    const id = String(camper && camper.id || "").trim();
    const shortName = String(camper && camper.shortName || "").trim();
    if (!id || !shortName) throw new Error(`Metadata camper at index ${index} requires id and shortName.`);
    if (camperIds[id]) throw new Error(`Duplicate metadata camper id '${id}'.`);
    if (camperNames[shortName]) throw new Error(`Duplicate metadata camper shortName '${shortName}'.`);
    if (typeof camper.dailyBaseRate !== "number" || camper.dailyBaseRate < 0) {
      throw new Error(`Metadata camper '${id}' has an invalid dailyBaseRate.`);
    }
    camperIds[id] = true;
    camperNames[shortName] = true;
  });

  if (!Array.isArray(metadata.delivery.drivers) || !metadata.delivery.drivers.length) {
    throw new Error("Metadata delivery.drivers is required and must be a non-empty array.");
  }
  const driverIds = new Set();
  metadata.delivery.drivers.forEach((driver, index) => {
    const id = String(driver && driver.id || "").trim().toLowerCase();
    const name = String(driver && driver.name || "").trim();
    const fuelType = String(driver && driver.fuelType || "").trim().toLowerCase();
    if (!id || !name) throw new Error(`Metadata driver at index ${index} requires id and name.`);
    if (driverIds.has(id)) throw new Error(`Duplicate metadata driver id '${id}'.`);
    if (typeof driver.roundTripMpg !== "number" || driver.roundTripMpg <= 0) {
      throw new Error(`Metadata driver '${id}' has an invalid roundTripMpg.`);
    }
    if (["gasoline", "diesel"].indexOf(fuelType) === -1) {
      throw new Error(`Metadata driver '${id}' has an invalid fuelType.`);
    }
    driverIds.add(id);
  });
  if (!driverIds.has("shane")) {
    throw new Error("Metadata delivery.drivers must include the 'shane' driver used by existing mileage calculations.");
  }

  const dumpingFee = metadata.fees.find(fee => String(fee && fee.id || "").trim().toLowerCase() === "dumping-fee");
  if (!dumpingFee || typeof dumpingFee.amount !== "number" || dumpingFee.amount < 0) {
    throw new Error("Metadata fees must include a valid 'dumping-fee' amount.");
  }

  const forbiddenKeyPattern = /^(?:api[-_]?key|secret|password|access[-_]?token|refresh[-_]?token)$/i;
  function rejectSecrets_(value, path) {
    if (!value || typeof value !== "object") return;
    Object.keys(value).forEach(key => {
      if (forbiddenKeyPattern.test(key)) {
        throw new Error(`Public metadata must not contain secret-like field '${path}${key}'.`);
      }
      rejectSecrets_(value[key], `${path}${key}.`);
    });
  }
  rejectSecrets_(metadata, "");

  return metadata;
}

function getCamperByShortName_(shortName) {
  const normalizedName = String(shortName || "").trim();
  return getMetadata_().campers.find(camper => camper.shortName === normalizedName) || null;
}

function getRateTierById_(tierId) {
  const normalizedId = String(tierId || "").trim();
  return getMetadata_().rateTiers.find(tier => tier.id === normalizedId) || null;
}

function getPricingRules_() {
  return getMetadata_().pricingRules;
}

function getGoogleAsset_(assetPath) {
  const pathParts = String(assetPath || "").split(".").filter(Boolean);
  let value = getMetadata_().googleAssets;
  pathParts.forEach(part => {
    value = value && value[part];
  });

  if (!value || typeof value !== "object") {
    throw new Error(`Google asset '${assetPath}' is missing from metadata.`);
  }
  return value;
}

function buildMetadataSheetData_(metadata) {
  const rows = [];
  const sections = [];
  const namedRanges = {};
  const addRow = values => {
    const row = (values || []).slice(0, 10);
    while (row.length < 10) row.push("");
    rows.push(row);
    return rows.length;
  };
  const addSection = title => {
    const row = addRow([title]);
    sections.push(row);
    return row;
  };
  const addNamedTable = (name, startRow, endRow, startColumn, endColumn) => {
    namedRanges[name] = {
      row: startRow,
      column: startColumn,
      numRows: endRow - startRow + 1,
      numColumns: endColumn - startColumn + 1
    };
  };
  const addNamedCell = (name, row, column) => addNamedTable(name, row, row, column, column);

  addRow(["Metadata source", getMetadataUrl_(), "Version", metadata.version, "Synced", new Date()]);
  addRow([]);

  addSection("Business settings");
  addRow(["Key", "Value"]);
  const businessStart = rows.length + 1;
  addRow(["business.name", metadata.business.name]);
  addRow(["business.homeAddress", metadata.business.homeAddress]);
  addRow(["business.contactEmail", metadata.business.contactEmail]);
  addRow(["business.contactPhone", metadata.business.contactPhone]);
  addNamedTable("metadataBusinessSettings", businessStart, rows.length, 1, 2);
  addRow([]);

  addSection("Pricing rules");
  addRow(["Key", "Value"]);
  const pricingStart = rows.length + 1;
  const pricingRows = {};
  pricingRows.weeklyThresholdNights = addRow(["weeklyThresholdNights", metadata.pricingRules.weeklyThresholdNights]);
  pricingRows.nhMealsRoomsTaxPct = addRow(["nhMealsRoomsTaxPct", metadata.pricingRules.nhMealsRoomsTaxPct / 100]);
  pricingRows.depositAmount = addRow(["depositAmount", metadata.pricingRules.depositAmount]);
  pricingRows.secondPaymentDaysBeforeStart = addRow(["secondPaymentDaysBeforeStart", metadata.pricingRules.paymentSchedule.secondPaymentDaysBeforeStart]);
  pricingRows.finalPaymentDaysBeforeStart = addRow(["finalPaymentDaysBeforeStart", metadata.pricingRules.paymentSchedule.finalPaymentDaysBeforeStart]);
  pricingRows.fullRefundDaysBeforeStart = addRow(["fullRefundDaysBeforeStart", metadata.pricingRules.cancellation.fullRefundDaysBeforeStart]);
  pricingRows.partialRefundDaysBeforeStart = addRow(["partialRefundDaysBeforeStart", metadata.pricingRules.cancellation.partialRefundDaysBeforeStart]);
  pricingRows.partialRefundPctExcludingDeposit = addRow(["partialRefundPctExcludingDeposit", metadata.pricingRules.cancellation.partialRefundPctExcludingDeposit / 100]);
  pricingRows.depositIsNonRefundable = addRow(["depositIsNonRefundable", metadata.pricingRules.cancellation.depositIsNonRefundable]);
  addNamedTable("metadataPricingRules", pricingStart, rows.length, 1, 2);
  addNamedCell("metadataWeeklyThresholdNights", pricingRows.weeklyThresholdNights, 2);
  addNamedCell("metadataNhMealsRoomsTaxPct", pricingRows.nhMealsRoomsTaxPct, 2);
  addNamedCell("metadataDepositAmount", pricingRows.depositAmount, 2);
  addNamedCell("metadataSecondPaymentDaysBeforeStart", pricingRows.secondPaymentDaysBeforeStart, 2);
  addNamedCell("metadataFinalPaymentDaysBeforeStart", pricingRows.finalPaymentDaysBeforeStart, 2);
  addNamedCell("metadataFullRefundDaysBeforeStart", pricingRows.fullRefundDaysBeforeStart, 2);
  addRow([]);

  addSection("Delivery settings");
  addRow(["Key", "Value"]);
  const deliveryStart = rows.length + 1;
  const deliveryPriceRow = addRow(["pricePerMileOneWay", metadata.delivery.pricePerMileOneWay]);
  const deliveryMinimumRow = addRow(["minimumFee", metadata.delivery.minimumFee]);
  addNamedTable("metadataDeliverySettings", deliveryStart, rows.length, 1, 2);
  addNamedCell("metadataDeliveryPricePerMile", deliveryPriceRow, 2);
  addNamedCell("metadataMinimumDeliveryFee", deliveryMinimumRow, 2);
  addNamedCell("deliveryPricePerMile", deliveryPriceRow, 2);
  addNamedCell("minDeliveryFee", deliveryMinimumRow, 2);
  addRow([]);

  addSection("Delivery drivers");
  addRow(["ID", "Name", "Round-trip MPG", "Fuel type"]);
  const driverStart = rows.length + 1;
  const driverRows = new Map();
  metadata.delivery.drivers.forEach(driver => {
    const row = addRow([
      driver.id,
      driver.name,
      driver.roundTripMpg,
      String(driver.fuelType).trim().toLowerCase()
    ]);
    driverRows.set(String(driver.id).trim().toLowerCase(), row);
  });
  addNamedTable("metadataDriverList", driverStart, rows.length, 1, 4);
  addNamedCell("RT_MPG_Shane", driverRows.get("shane"), 3);
  addRow([]);

  addSection("Campers");
  addRow(["ID", "Website Key", "Short Name", "Full Name", "Daily Base Rate", "Rentable", "For Sale", "Active", "Rental Visible", "Sale Visible"]);
  const camperStart = rows.length + 1;
  metadata.campers.forEach(camper => addRow([
    camper.id,
    camper.websiteKey,
    camper.shortName,
    camper.fullName,
    camper.dailyBaseRate,
    camper.status.rentable,
    camper.status.forSale,
    camper.status.active,
    camper.website.rentalVisible,
    camper.website.saleVisible
  ]));
  addNamedTable("metadataCamperTable", camperStart, rows.length, 1, 10);
  addNamedTable("metadataCamperList", camperStart, rows.length, 3, 3);
  addNamedTable("metadataCamperBaseRates", camperStart, rows.length, 5, 5);
  addRow([]);

  addSection("Rate tiers");
  addRow(["ID", "Label", "Nightly Discount", "Weekly Discount"]);
  const tierStart = rows.length + 1;
  metadata.rateTiers.forEach(tier => addRow([
    tier.id,
    tier.label,
    tier.discountPct.nightly / 100,
    tier.discountPct.weekly / 100
  ]));
  addNamedTable("metadataRateTierTable", tierStart, rows.length, 1, 4);
  addNamedTable("metadataRateTierList", tierStart, rows.length, 2, 2);
  addNamedTable("metadataNightlyDiscounts", tierStart, rows.length, 3, 3);
  addNamedTable("metadataWeeklyDiscounts", tierStart, rows.length, 4, 4);
  addRow([]);

  addSection("Holidays");
  addRow(["ID", "Label", "Surcharge", "Description"]);
  const holidayStart = rows.length + 1;
  metadata.holidays.forEach(holiday => addRow([
    holiday.id,
    holiday.label,
    holiday.surchargePct / 100,
    holiday.description
  ]));
  addNamedTable("metadataHolidayTable", holidayStart, rows.length, 1, 4);
  addNamedTable("metadataHolidayList", holidayStart, rows.length, 2, 2);
  addNamedTable("metadataHolidayRates", holidayStart, rows.length, 3, 3);
  addNamedTable("metadataHolidayDescriptions", holidayStart, rows.length, 4, 4);
  addRow([]);

  addSection("Fees");
  addRow(["ID", "Label", "Amount", "Description"]);
  const feeStart = rows.length + 1;
  const feeRows = new Map();
  metadata.fees.forEach(fee => {
    const row = addRow([fee.id, fee.label, fee.amount, fee.description]);
    feeRows.set(String(fee.id).trim().toLowerCase(), row);
  });
  addNamedTable("metadataFeeTable", feeStart, rows.length, 1, 4);
  addNamedTable("metadataFeeList", feeStart, rows.length, 2, 2);
  addNamedTable("metadataFeeAmounts", feeStart, rows.length, 3, 3);
  addNamedTable("metadataFeeLookup", feeStart, rows.length, 2, 3);
  addNamedCell("metadataDumpingFee", feeRows.get("dumping-fee"), 3);
  addNamedCell("dumpingFee", feeRows.get("dumping-fee"), 3);
  addRow([]);

  addSection("Add-ons");
  addRow(["ID", "Label", "Amount", "Description"]);
  const addOnStart = rows.length + 1;
  metadata.addOns.forEach(addOn => addRow([addOn.id, addOn.label, addOn.amount, addOn.description]));
  addNamedTable("metadataAddOnTable", addOnStart, rows.length, 1, 4);
  addNamedTable("metadataAddOnList", addOnStart, rows.length, 2, 2);
  addNamedTable("metadataAddOnAmounts", addOnStart, rows.length, 3, 3);
  addNamedTable("metadataAddOnLookup", addOnStart, rows.length, 2, 3);
  addRow([]);

  addSection("Google assets");
  addRow(["Type", "Key", "Name", "ID"]);
  const assetStart = rows.length + 1;
  [
    ["calendar", "calendar", metadata.googleAssets.calendar],
    ["folder", "topLevelFolder", metadata.googleAssets.topLevelFolder],
    ["folder", "quoteFolder", metadata.googleAssets.quoteFolder],
    ["template", "workflowSpreadsheetTemplate", metadata.googleAssets.workflowSpreadsheetTemplate],
    ["spreadsheet", "contactsSpreadsheet", metadata.googleAssets.contactsSpreadsheet],
    ["template", "quoteAgreement", metadata.googleAssets.templates.quoteAgreement],
    ["template", "quoteEmail", metadata.googleAssets.templates.quoteEmail],
    ["template", "invoice", metadata.googleAssets.templates.invoice]
  ].forEach(item => addRow([item[0], item[1], item[2].name || item[2].sheetName || "", item[2].id]));
  addNamedTable("metadataGoogleAssetList", assetStart, rows.length, 1, 4);

  return {
    rows: rows,
    sectionRows: sections,
    namedRanges: namedRanges,
    percentRanges: [
      `B${pricingRows.nhMealsRoomsTaxPct}`,
      `B${pricingRows.partialRefundPctExcludingDeposit}`,
      `C${tierStart}:D${tierStart + metadata.rateTiers.length - 1}`,
      `C${holidayStart}:C${holidayStart + metadata.holidays.length - 1}`
    ],
    currencyRanges: [
      `B${pricingRows.depositAmount}`,
      `B${deliveryPriceRow}:B${deliveryMinimumRow}`,
      `E${camperStart}:E${camperStart + metadata.campers.length - 1}`,
      `C${feeStart}:C${feeStart + metadata.fees.length - 1}`,
      `C${addOnStart}:C${addOnStart + metadata.addOns.length - 1}`
    ]
  };
}

function replaceNamedRange_(spreadsheet, name, range) {
  const matches = spreadsheet.getNamedRanges()
    .filter(namedRange => namedRange.getName() === name);

  if (!matches.length) {
    spreadsheet.setNamedRange(name, range);
    return;
  }

  // Updating the range in place preserves formulas that reference its name.
  matches[0].setRange(range);
  matches.slice(1).forEach(namedRange => namedRange.remove());
}

function removeNamedRanges_(spreadsheet, names) {
  const namesToRemove = new Set(names);
  spreadsheet.getNamedRanges()
    .filter(namedRange => namesToRemove.has(namedRange.getName()))
    .forEach(namedRange => namedRange.remove());
}

function migrateQuoteToMetadata_(spreadsheet) {
  const quoteSheet = spreadsheet.getSheetByName(QUOTE_SHEET_NAME);
  if (!quoteSheet) throw new Error(`Sheet '${QUOTE_SHEET_NAME}' not found.`);

  const expectedLabels = [
    ["A20", "Add-Ons"],
    ["A22", "Fees"],
    ["A23", "8.5% NH M&R Tax"],
    ["A24", "Expected Income"],
    ["A25", "Deposit req:"],
    ["A26", "Next Payment"],
    ["A27", "Final payment:"],
    ["A28", "Full refund date:"]
  ];
  expectedLabels.forEach(item => {
    const actualLabel = String(quoteSheet.getRange(item[0]).getDisplayValue() || "").trim();
    if (actualLabel !== item[1]) {
      throw new Error(`Quote layout mismatch at ${item[0]}: expected '${item[1]}', found '${actualLabel}'.`);
    }
  });

  quoteSheet.getRange("A2").setValue("Static pricing and camper data comes from the generated 'metadata' tab. Runtime values remain local.");
  quoteSheet.getRange("C8").setFormula('=IF(ISNUMBER(B8),TEXT(B8,"ddd"),"invalid date")');
  quoteSheet.getRange("C9").setFormula('=IF(ISNUMBER(B9),TEXT(B9,"ddd"),"invalid date")');
  quoteSheet.getRange("B11").setFormula('=IFERROR(SUMIF(metadataHolidayList,C11,metadataHolidayRates),"invalid input")');
  quoteSheet.getRange("D11").setFormula('=IFERROR(INDEX(metadataHolidayDescriptions,MATCH(C11,metadataHolidayList,0)),"")');
  quoteSheet.getRange("C14").setFormula('=IF(ISNUMBER(B32),B32,IFERROR(INDEX(metadataCamperBaseRates,MATCH(B13,metadataCamperList,0))*(1-IF(C10="weekly",INDEX(metadataWeeklyDiscounts,MATCH(B14,metadataRateTierList,0)),INDEX(metadataNightlyDiscounts,MATCH(B14,metadataRateTierList,0))))*(1+B11),"invalid input"))');
  quoteSheet.getRange("B17").setFormula('=IF(ISNUMBER(B30),B30,IF(B16="YES",MAX(C17*metadataDeliveryPricePerMile,metadataMinimumDeliveryFee),0))');
  quoteSheet.getRange("E17").setFormula("=metadataDeliveryPricePerMile");
  quoteSheet.getRange("B20").setFormula('=IFERROR(VLOOKUP(C20,metadataAddOnLookup,2,FALSE),0)+IFERROR(VLOOKUP(D20,metadataAddOnLookup,2,FALSE),0)+IFERROR(VLOOKUP(E20,metadataAddOnLookup,2,FALSE),0)+IFERROR(VLOOKUP(F20,metadataAddOnLookup,2,FALSE),0)');
  quoteSheet.getRange("B22").setFormula('=IFERROR(VLOOKUP(C22,metadataFeeLookup,2,FALSE),0)+IFERROR(VLOOKUP(D22,metadataFeeLookup,2,FALSE),0)+IFERROR(VLOOKUP(E22,metadataFeeLookup,2,FALSE),0)');
  quoteSheet.getRange("B23").setFormula("=IF(ISNUMBER(B34),0,IF(ISNUMBER(B31),B31,metadataNhMealsRoomsTaxPct*B15))");
  quoteSheet.getRange("B24").setFormula("=IF(ISNUMBER(B34),SUM(B15:B23)*0.75,SUM(B15:B23))-B33");
  quoteSheet.getRange("C24").setFormula("=IF(ISNUMBER(B34),SUM(B15:B23)*0.25,0)");
  quoteSheet.getRange("E24").setFormula("=SUM(B15:B23)");
  quoteSheet.getRange("B25").setFormula("=metadataDepositAmount");
  quoteSheet.getRange("B26").setFormula("=ROUND((B24-B25)/2,2)");
  quoteSheet.getRange("C26").setFormula("=B8-metadataSecondPaymentDaysBeforeStart");
  quoteSheet.getRange("B27").setFormula("=ROUND(B24-B25-B26,2)");
  quoteSheet.getRange("C27").setFormula("=B8-metadataFinalPaymentDaysBeforeStart");
  quoteSheet.getRange("B28").setFormula("=B8-metadataFullRefundDaysBeforeStart");

  // Repair cells written by the earlier migration before Driver/Towing rows were added.
  [
    ["B18", "metadataAddOnLookup"],
    ["B21", "metadataNhMealsRoomsTaxPct"],
    ["C25", "metadataFinalPaymentDaysBeforeStart"]
  ].forEach(item => {
    const cell = quoteSheet.getRange(item[0]);
    if (cell.getFormula().indexOf(item[1]) !== -1) cell.clearContent();
  });
  quoteSheet.getRange("C18:F18").clearDataValidations();

  const validations = [
    ["B13", "metadataCamperList"],
    ["B14", "metadataRateTierList"],
    ["C11", "metadataHolidayList"],
    ["C20:F20", "metadataAddOnList"],
    ["C22:E22", "metadataFeeList"]
  ];
  validations.forEach(item => {
    const sourceRange = spreadsheet.getRangeByName(item[1]);
    if (!sourceRange) throw new Error(`Named range '${item[1]}' is missing after metadata sync.`);
    const rule = SpreadsheetApp.newDataValidation()
      .requireValueInRange(sourceRange, true)
      .setAllowInvalid(false)
      .build();
    quoteSheet.getRange(item[0]).setDataValidation(rule);
  });
}

function isSummaryCamperFormula_(formula) {
  return /^=INDEX\((?:metadataCamperList|#REF!),\d+,1\)$/i.test(String(formula || "").replace(/\s+/g, ""));
}

function migrateSummaryToMetadata_(spreadsheet, metadata) {
  const summarySheet = spreadsheet.getSheetByName(SUMMARY_SHEET_NAME);
  if (!summarySheet) throw new Error(`Sheet '${SUMMARY_SHEET_NAME}' not found.`);
  if (!metadata || !Array.isArray(metadata.campers) || !metadata.campers.length) {
    throw new Error("Metadata must include at least one camper before migrating the Summary sheet.");
  }
  if (String(summarySheet.getRange("B21").getDisplayValue() || "").trim() !== "Total") {
    throw new Error("Summary layout mismatch: expected 'Total' in B21.");
  }

  const outputRow = 21;
  const firstOutputColumn = 3;
  const camperCount = metadata.campers.length;
  const columnsToInspect = Math.max(
    camperCount,
    summarySheet.getLastColumn() - firstOutputColumn + 1
  );
  const existingRange = summarySheet.getRange(outputRow, firstOutputColumn, 1, columnsToInspect);
  const existingFormulas = existingRange.getFormulas()[0];
  const existingValues = existingRange.getValues()[0];

  for (let index = 0; index < camperCount; index++) {
    const hasContent = existingFormulas[index] || existingValues[index] !== "";
    if (hasContent && !isSummaryCamperFormula_(existingFormulas[index])) {
      const cell = existingRange.getCell(1, index + 1).getA1Notation();
      throw new Error(`Cannot write camper summary formulas because ${SUMMARY_SHEET_NAME}!${cell} contains unmanaged content.`);
    }
  }

  existingFormulas.forEach((formula, index) => {
    if (isSummaryCamperFormula_(formula)) {
      existingRange.getCell(1, index + 1).clearContent();
    }
  });

  const camperFormulas = metadata.campers.map((camper, index) =>
    `=INDEX(metadataCamperList,${index + 1},1)`
  );
  summarySheet
    .getRange(outputRow, firstOutputColumn, 1, camperCount)
    .setFormulas([camperFormulas]);
}

function repairDriverMpgFormula_(formula) {
  const replacement = 'VLOOKUP("shane",metadataDriverList,3,FALSE)';
  return String(formula || "")
    .replace(/RT_MPG_Shane/g, replacement)
    .replace(/VLOOKUP\(\s*"shane"\s*,\s*#REF!\s*,\s*3\s*,\s*FALSE\s*\)/gi, replacement);
}

function migrateBookingsToMetadata_(spreadsheet) {
  const bookingsSheet = spreadsheet.getSheetByName(BOOKINGS_SHEET_NAME);
  if (!bookingsSheet) throw new Error(`Sheet '${BOOKINGS_SHEET_NAME}' not found.`);

  bookingsSheet.getRange("K:K").clearDataValidations();

  const mileageCostRange = bookingsSheet.getRange(
    BOOKINGS_HEADER_ROW + 1,
    8,
    Math.max(bookingsSheet.getLastRow() - BOOKINGS_HEADER_ROW, 1),
    1
  );
  mileageCostRange.getFormulas().forEach((row, index) => {
    const formula = row[0];
    const migratedFormula = repairDriverMpgFormula_(formula);
    if (!formula || migratedFormula === formula) return;

    mileageCostRange.getCell(index + 1, 1).setFormula(migratedFormula);
  });
}

function migrateContractDataToMetadata_(spreadsheet) {
  const contractDataSheet = spreadsheet.getSheetByName(CONTRACT_DATA_SHEET_NAME);
  if (!contractDataSheet) throw new Error(`Sheet '${CONTRACT_DATA_SHEET_NAME}' not found.`);

  contractDataSheet.getRange("B6").setFormula(
    '=IFERROR(INDEX(metadataCamperTable,MATCH(Quote!B13,metadataCamperList,0),4),"Error")'
  );
  contractDataSheet.getRange("C12").setFormula(
    '=if(Quote!B16="YES",CONCATENATE("based on ",Quote!C17, " mi from Milford, NH @$", Quote!E17, "/mi with $", metadataMinimumDeliveryFee, " minimum"),"customer will tow to rental site and return to owner")'
  );
  contractDataSheet.getRange("A16").setFormula(
    '=CONCATENATE("Note: costs assume campsite will have electric/water/septic; otherwise a $",metadataDumpingFee," dumping fee will be applied")'
  );
}

function migrateMileageToMetadata_(spreadsheet) {
  const mileageSheet = spreadsheet.getSheetByName(MILEAGE_SHEET_NAME);
  if (!mileageSheet) throw new Error(`Sheet '${MILEAGE_SHEET_NAME}' not found.`);

  mileageSheet.getRange("C6").setFormula(
    "=VLOOKUP(LOWER($B$2),metadataDriverList,3,FALSE)"
  );
  mileageSheet.getRange("D4").setFormula(
    '=SWITCH(VLOOKUP(LOWER($B$2),metadataDriverList,4,FALSE),"gasoline",gasCurrentPrice,"diesel",dieselCurrentPrice,NA())'
  );
  mileageSheet.getRange("H4").setFormula("=metadataDeliveryPricePerMile");
  mileageSheet.getRange("I4").setFormula("=MAX(H4*A4,metadataMinimumDeliveryFee)");

  const historicalMileageCostRange = mileageSheet.getRange("E35:E37");
  historicalMileageCostRange.getFormulas().forEach((row, index) => {
    const formula = row[0];
    const migratedFormula = repairDriverMpgFormula_(formula);
    if (!formula || migratedFormula === formula) return;

    historicalMileageCostRange.getCell(index + 1, 1).setFormula(migratedFormula);
  });
}

function getCurrentCalendarYear_() {
  return Number(Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "yyyy"));
}

function getCanonicalWorkflowYear_(fileName) {
  const match = String(fileName || "").trim().match(/^HHRentals-(\d{4})IncomeExpenses$/);
  return match ? Number(match[1]) : null;
}

function getMetadataSyncTargets_(metadata) {
  const targets = [];
  const seenFileIds = new Set();
  const currentYear = getCurrentCalendarYear_();

  function addTarget_(file, kind, year) {
    if (!file || seenFileIds.has(file.getId())) return;

    seenFileIds.add(file.getId());
    targets.push({
      file: file,
      spreadsheet: SpreadsheetApp.openById(file.getId()),
      kind: kind,
      year: year,
      label: file.getName()
    });
  }

  const templateConfig = metadata.googleAssets.workflowSpreadsheetTemplate;
  const templateFile = getDriveFileByIdOrName_(templateConfig.id, templateConfig.name);
  if (!templateFile) {
    throw new Error(`Workflow spreadsheet template '${templateConfig.name}' was not found.`);
  }
  if (templateFile.getMimeType() !== MimeType.GOOGLE_SHEETS) {
    throw new Error(`Workflow spreadsheet template '${templateConfig.name}' is not a Google Sheet.`);
  }
  addTarget_(templateFile, "template", null);

  const workflowFolder = getWorkflowSpreadsheetFolder_(metadata);
  const files = workflowFolder.getFiles();

  while (files.hasNext()) {
    const file = files.next();
    if (file.getMimeType() !== MimeType.GOOGLE_SHEETS) continue;

    const year = getCanonicalWorkflowYear_(file.getName());
    if (year === null || year < currentYear) continue;

    addTarget_(file, "year", year);
  }

  targets.sort((first, second) => {
    if (first.kind !== second.kind) return first.kind === "template" ? -1 : 1;
    return (first.year || 0) - (second.year || 0) || first.label.localeCompare(second.label);
  });

  return targets;
}

function getMetadataSyncWriteRanges_(spreadsheet, metadata, layout) {
