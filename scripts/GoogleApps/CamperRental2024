/**
 * Inserts a data row immediately before the {{insertRow}} template row.
 * The preceding row supplies formatting; the template row supplies default
 * values and formulas. Column A is then set to today's date.
 */
function insertEntryRowAtPlaceholder_(sheet) {
  const placeholder = findExactCell_(sheet, ENTRY_INSERT_PLACEHOLDER);
  if (!placeholder) throw new Error(`Cannot find ${ENTRY_INSERT_PLACEHOLDER} on '${sheet.getName()}'.`);

  const placeholderRow = placeholder.getRow();
  if (placeholderRow <= 1) throw new Error(`Cannot insert above row ${placeholderRow} on '${sheet.getName()}'.`);

  const lastColumn = sheet.getLastColumn();
  const defaultsRange = sheet.getRange(placeholderRow, 1, 1, lastColumn);
  const defaultValues = defaultsRange.getValues();
  const defaultFormulas = defaultsRange.getFormulas();
  sheet.insertRowBefore(placeholderRow);

  const newRow = sheet.getRange(placeholderRow, 1, 1, lastColumn);
  const formatSource = sheet.getRange(placeholderRow - 1, 1, 1, lastColumn);
  const validationSource = sheet.getRange(placeholderRow + 1, 1, 1, lastColumn);

  formatSource.copyTo(newRow, SpreadsheetApp.CopyPasteType.PASTE_FORMAT, false);
  // Copy the native validation layer so dropdown chip colors are retained.
  validationSource.copyTo(newRow, SpreadsheetApp.CopyPasteType.PASTE_DATA_VALIDATION, false);
  newRow.setValues(defaultValues);

  defaultFormulas[0].forEach((formula, columnIndex) => {
    if (formula) newRow.getCell(1, columnIndex + 1).setFormula(formula);
  });

  newRow.getCell(1, 1).setValue(new Date());
  newRow.getCell(1, ENTRY_INSERT_CHECKBOX_COLUMN).setValue(0).clearDataValidations();
  sheet.getRange(placeholderRow + 1, ENTRY_INSERT_CHECKBOX_COLUMN).setValue(false);
}

